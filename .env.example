# SQLite file, created by `npm run db:push`
DATABASE_URL="file:./dev.db"

# Public origin, used in links inside feeds, llms.txt and OpenAPI. Optional locally.
# NEXT_PUBLIC_BASE_URL="https://events.example.com"

# Protects POST/GET /api/scrape. Required in production (the endpoint refuses without it).
# ADMIN_API_KEY="long-random-string"

# Optional: identify your scraper politely to the sources.
# SCRAPER_USER_AGENT="my-events-hub/1.0 (me@example.com)"
